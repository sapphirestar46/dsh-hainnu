{
  "name": "dsh-hainnu",
  "version": "0.1.0",
  "private": true,
  "description": "登录海南师范大学统一身份认证，本地启动海师模型代理，并把 deepseek-flash 接入 DSH。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node test/guard-smoke.mjs && node test/proxy-smoke.mjs && node test/login-smoke.mjs && node test/client-smoke.mjs && node test/modelconfig-smoke.mjs"
  }
}
